# Template only. Real values go in .env — never here.
# pnpm dev: the dev database from compose.yaml. Never the E2E one (playwright.config.ts sets its
# own), and never Neon from your machine except to migrate or seed it on purpose.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/xd_memories_dev
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Mail for sign-up confirmation and password reset. Locally: Mailpit from compose.yaml (inbox at
# http://localhost:8025). Production: smtps://you%40gmail.com:<app password>@smtp.gmail.com:465
SMTP_URL=smtp://localhost:1025
MAIL_FROM=xd-memories <you@example.com>
TMDB_API_TOKEN=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
RECOMMENDER=heuristic   # heuristic | ollama | groq
MUSICBRAINZ_USER_AGENT=xd-memories/0.0 (you@example.com)
